VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Google reCAPTCHA (v2 checkbox) -------------------------------------
# Public site key. Safe to ship in the browser bundle and used by the
# <RecaptchaGate> widget on the sign-up, login and sandbox pages as a
# client-side speed bump only (it is not verified server-side).
# Create/read it at https://www.google.com/recaptcha/admin (reCAPTCHA v2).
VITE_RECAPTCHA_SITE_KEY=

# --- Staff allowlist ----------------------------------------------------
# The lecturer staff-email allowlist lives in the DATABASE, table
# `staff_email_domains` (migrations/09_role_server_side.sql), not here.
# Manage it in the SQL editor, e.g.:
#   insert into public.staff_email_domains (domain) values ('uni.edu');
# The client reads that table at sign-up; handle_new_user() enforces the
# same list server-side.
