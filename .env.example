VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_RECAPTCHA_SITE_KEY=
VITE_PUBLIC_APP_URL=        # Public production URL of the app. Verification QR codes point here; unset => window.location.origin (localhost when printed from a dev machine).
# reCAPTCHA v2 checkbox site key (public). No backend verification is enforced.
# The secret key goes to your server/verifier, not here.
# Lecturer staff-email allowlist now lives in the DATABASE, table
# `staff_email_domains` (migrations/09_role_server_side.sql), not here.
# Manage it in the SQL editor, e.g.:
#   insert into public.staff_email_domains (domain) values ('uni.edu');
# The client reads that table at sign-up; handle_new_user() enforces the
# same list server-side.
