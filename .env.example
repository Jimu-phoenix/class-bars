VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public hCaptcha sitekey (from https://dashboard.hcaptcha.com). Required because Supabase
# Captcha protection is enabled for anonymous sign-ins. The hCaptcha secret key stays only
# in Supabase Dashboard -> Authentication -> Sign In / Providers, never in this file.
VITE_HCAPTCHA_SITEKEY=
# Lecturer staff-email allowlist now lives in the DATABASE, table
# `staff_email_domains` (migrations/09_role_server_side.sql), not here.
# Manage it in the SQL editor, e.g.:
#   insert into public.staff_email_domains (domain) values ('uni.edu');
# The client reads that table at sign-up; handle_new_user() enforces the
# same list server-side.
